{
  "manifest_version": 3,
  "name": "Lumia Scroll Capture",
  "version": "1.5.0",
  "description": "Companion extension for the Lumia desktop app — captures full-page scrolling screenshots with exact pixel offsets.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "alarms"],
  "optional_host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Lumia Scroll Capture",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
